# Copy this file to .env.local and fill in real values from:
# Supabase Dashboard -> your project -> Settings -> API

# Safe to expose in the browser (protected by Row Level Security policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: server-side only, bypasses Row Level Security. Never prefix with
# NEXT_PUBLIC_, never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
