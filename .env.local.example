# Copy this file to .env.local and fill in real values from:
# Supabase Dashboard -> your project -> Settings -> API

# Safe to expose in the browser (protected by Row Level Security policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: server-side only, bypasses Row Level Security. Never prefix with
# NEXT_PUBLIC_, never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, local dev only: if both are set, `npm run dev` silently signs
# you in as this driver whenever there's no active session, so you never
# have to hit the login form while working locally. Leave unset (the
# default) to keep normal login behavior — and never set these in Vercel's
# env vars, since that would remove login for the real deployed app.
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_PASSWORD=
